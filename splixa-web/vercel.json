{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|privacy|terms|delete-account|pricing|alternatives|blog|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
