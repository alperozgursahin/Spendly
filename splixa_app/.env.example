# Backend
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat public SDK keys and entitlement identifier
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=
REVENUECAT_IOS_PUBLIC_SDK_KEY=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=pro

# Firebase public client configuration. Prefer `flutterfire configure` for
# native platform files; these values also let AnalyticsService initialize
# from the existing dotenv bootstrap.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MACOS_APP_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MEASUREMENT_ID=
FIREBASE_IOS_BUNDLE_ID=net.splixa.app
