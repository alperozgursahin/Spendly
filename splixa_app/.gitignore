# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Local IDE state
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
!/pubspec.lock
!/android/gradlew
!/android/gradlew.bat
!/android/gradle/wrapper/gradle-wrapper.jar

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Runtime configuration. The example contract is safe to commit.
.env
.env.*
!.env.example
env.config

# Firebase platform configuration is injected per release environment.
**/google-services.json
**/GoogleService-Info.plist
.firebase/
firebase-debug.log

# Android Signing & Secrets (KRİTİK!)
**/key.properties
*.jks
*.keystore
**/local.properties

# Supabase CLI link metadata and local service versions.
supabase/.temp/

# Build output at any depth. The stock Flutter ignore only covers /build/, so
# android/build/ and android/app/build/ were still being offered to git.
build/
.gradle/
.kotlin/

# FVM pins the SDK here; the SDK itself must never enter the repo.
.fvm/

# Scratch folder for generated hand-off notes, not part of the app.
Claude outputs/

# One-off SQL kept at the repo root before supabase/migrations/ existed.
# supabase/migrations/ is the schema's source of truth; these are stale copies.
/supabase_*.sql
